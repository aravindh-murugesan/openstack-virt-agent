{{ openstack_virt_agent_log_path }}/openstack-virt-agent.log {
daily
size {{ openstack_virt_agent_log_size }}
rotate {{ openstack_virt_agent_log_retention_days }}
compress
delaycompress
missingok
notifempty
dateext
dateformat -%Y%m%d-%s
create 0640 {{ openstack_virt_agent_user }} adm
sharedscripts
postrotate
systemctl reload {{ openstack_virt_agent_service_name }} >/dev/null 2>&1 || true
endscript
}